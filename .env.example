# =================================================================
# INFOLENS AI ENGINE CONFIGURATION
# Copy to .env and configure provider credentials as needed.
# =================================================================

# Environment Mode: development | production | test
INFOLENS_AI_ENVIRONMENT=development
INFOLENS_AI_DEBUG=false
INFOLENS_AI_LOG_LEVEL=INFO

# LLM Provider Configuration
# Supported options: mock | openai | gemini | anthropic | ollama
INFOLENS_AI_LLM_PROVIDER=mock
INFOLENS_AI_LLM_MODEL=gpt-4o-mini
INFOLENS_AI_LLM_API_KEY=your-api-key-here
# Optional Base URL override (for Gemini OpenAI-compatible endpoint, Ollama, or local proxies)
# INFOLENS_AI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
INFOLENS_AI_LLM_TIMEOUT_SECONDS=30.0
INFOLENS_AI_LLM_MAX_RETRIES=2
INFOLENS_AI_LLM_TEMPERATURE=0.1
INFOLENS_AI_LLM_MAX_TOKENS=2048

# Embedding Provider Configuration
# Supported options: sentence_transformers | openai | mock
INFOLENS_AI_EMBEDDING_PROVIDER=sentence_transformers
INFOLENS_AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
INFOLENS_AI_EMBEDDING_DIMENSION=384
INFOLENS_AI_EMBEDDING_BATCH_SIZE=32

# Vector Store & Retrieval Settings
INFOLENS_AI_VECTOR_STORE_TYPE=in_memory_persistent
INFOLENS_AI_VECTOR_STORE_DIR=./data/vector_store
INFOLENS_AI_RETRIEVAL_TOP_K=5
INFOLENS_AI_RETRIEVAL_SIMILARITY_THRESHOLD=0.15
INFOLENS_AI_ENABLE_BM25_RERANKING=true

# Text Chunking Settings
INFOLENS_AI_CHUNK_SIZE=500
INFOLENS_AI_CHUNK_OVERLAP=100
INFOLENS_AI_CHUNK_MIN_SIZE=40

# OCR Settings (Tesseract)
INFOLENS_AI_OCR_ENABLED=false
INFOLENS_AI_OCR_LANGUAGE=eng
INFOLENS_AI_OCR_MIN_EXTRACTED_CHARS=30
# Optional custom path to tesseract binary if not on PATH
# INFOLENS_AI_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Context & Safety Limits
INFOLENS_AI_MAX_FILE_SIZE_BYTES=52428800
INFOLENS_AI_MAX_CONTEXT_BUDGET_CHARACTERS=12000
