# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Document Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY=change-this-in-production-to-a-very-secure-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/doc_intelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis & Caching
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# File Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_BYTES=52428800

# AI / LLM & Embeddings
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSIONS=1536

# Vector Store
VECTOR_STORE_BACKEND=sqlite_vec
VECTOR_TABLE_NAME=document_embeddings

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
